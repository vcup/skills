{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "adapters/omp/**/*.ts",
    "scripts/build-ensemble.ts",
    "scripts/build-ensemble.test.ts",
    "scripts/pack-omp.ts",
    "scripts/pack-omp.test.ts",
    "scripts/pack-dsh.ts",
    "scripts/pack-dsh.test.ts",
    "scripts/build-dsh-bundle.ts",
    "scripts/check-dsh-bundle.ts",
    "scripts/check-dsh-bundle.test.ts",
    "scripts/check-docs.test.ts",
    "scripts/project-tasks.ts",
    "scripts/project-tasks.test.ts",
    "scripts/makefile.test.ts",
    "scripts/profile-check.ts",
    "scripts/profile-check.test.ts",
    "scripts/check-isolation.ts",
    "scripts/check-isolation.test.ts",
    "adapters/dsh/compatibility.ts",
    "scripts/check-upstream.ts",
    "scripts/check-upstream.test.ts",
    "adapters/dsh-agent-wait/meta.ts",
    "adapters/dsh-agent-wait/wait.ts",
    "adapters/dsh-agent-wait/wait.test.ts",
    "scripts/pack-dsh-agent-wait.ts",
    "scripts/pack-dsh-agent-wait.test.ts"
  ]
}
