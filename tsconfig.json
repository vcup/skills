{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"]
  },
  "include": [
    "adapters/omp/**/*.ts",
    "scripts/build-ensemble.ts",
    "scripts/build-ensemble.test.ts",
    "scripts/pack-omp.ts",
    "scripts/pack-omp.test.ts",
    "scripts/pack-dsh.ts",
    "scripts/pack-dsh.test.ts",
    "scripts/project-tasks.ts",
    "scripts/project-tasks.test.ts",
    "scripts/makefile.test.ts"
  ]
}
